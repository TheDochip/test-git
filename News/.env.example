# Скопируйте в .env и заполните. Сам .env в git не попадает.

SECRET_KEY=

# Почта (для Gmail нужен "пароль приложения", а не пароль от аккаунта).
# Если оставить пустым, в dev письма печатаются в консоль.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# DEFAULT_FROM_EMAIL=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Только для продакшена (config.settings.prod)
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=0
