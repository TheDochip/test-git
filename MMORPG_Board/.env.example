# --- База данных PostgreSQL (если DB_NAME не задан — используется SQLite) ---
DB_NAME=mmorpg_board
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000

# --- Почта (если EMAIL_HOST не задан — письма печатаются в консоль) ---
# Пример для Яндекса: нужен «пароль приложения» из настроек Яндекс ID
#EMAIL_HOST=smtp.yandex.ru
#EMAIL_PORT=465
#EMAIL_USE_SSL=True
#EMAIL_HOST_USER=your_login@yandex.ru
#EMAIL_HOST_PASSWORD=app_password
#DEFAULT_FROM_EMAIL=your_login@yandex.ru
